# Variables for the single container. Paste them into the host that runs the image.
# On RunPod that host is the pod's environment form. On another host it is `docker run -e`.

APP_ENV=development
SESSION_SECRET=replace-with-32-or-more-random-characters
WORKER_SHARED_SECRET=replace-with-a-different-32-or-more-random-characters

# The address people open. For a RunPod proxy this is the HTTPS URL of port 3000.
WEB_PUBLIC_URL=https://example.proxy.runpod.net
API_PUBLIC_URL=https://example.proxy.runpod.net
CORS_ORIGINS=https://example.proxy.runpod.net

# Gated Flux weights. The image does not contain this token.
HF_TOKEN=

# Space-separated worker programs. Use "flux qwen-image" to test both on one GPU.
# The pod loads a model for one picture, then releases the GPU.
CREATIVO_WORKERS=flux

# How long the orchestrator waits for more Flux jobs before starting a GPU pass.
BATCH_FILL_SECONDS=3

# Weights and pictures. A RunPod volume is mounted at /workspace, and the container uses that when it is present.
# CREATIVO_DATA_ROOT=/workspace/creativo
