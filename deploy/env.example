# Copy to deploy/.env on the GPU host. This file is the same on every host.
# RunPod, another rental GPU, or your own machine only changes the public URL and the SSH target.

APP_ENV=development
POSTGRES_PASSWORD=creativo
SESSION_SECRET=replace-with-32-or-more-random-characters
WORKER_SHARED_SECRET=replace-with-a-different-32-or-more-random-characters

# The address people open in a browser. On RunPod this is the proxy URL for port 3000.
# On another host it is that host's domain. The API is reached through the web server.
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Empty keeps the studio on the same origin as the page, so the image does not bake in a vendor URL.
NEXT_PUBLIC_API_URL=

# Hugging Face token for gated weights. The image does not contain it.
HF_TOKEN=

# Where the pulled images live. CI publishes to GitHub's registry; override for any other registry.
# CREATIVO_IMAGE_PREFIX=ghcr.io/your-org/creativo
# CREATIVO_TAG=latest
